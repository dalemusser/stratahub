{{ define "missionhydrosci_signedin" }}
  {{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="flex flex-col items-center justify-center h-full text-center">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-8 max-w-md">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">You are signed in again</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-6">
      Go back to the tab where your game is running and keep playing. The notice there goes away in a few moments.
    </p>
    <button type="button" id="mhs-signedin-close"
            class="inline-block px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400">
      Close this tab
    </button>
    <p id="mhs-signedin-hint" class="hidden mt-4 text-sm text-gray-500 dark:text-gray-400" role="status">
      This tab could not close itself. Close it yourself, then go back to your game.
    </p>
  </div>
</div>
<script>
(function() {
  // Tell the game's tab to check its sign-in now rather than at its next beat.
  try { new BroadcastChannel('mhs-signin').postMessage('signed-in'); } catch (e) { /* the game's tab checks by itself */ }
  var btn = document.getElementById('mhs-signedin-close');
  var hint = document.getElementById('mhs-signedin-hint');
  if (btn) btn.addEventListener('click', function() {
    window.close();
    // A browser only lets a page close a tab the page's opener created;
    // when it refuses, say what to do instead.
    setTimeout(function() { if (hint) hint.classList.remove('hidden'); }, 400);
  });
})();
</script>
{{ end }}
