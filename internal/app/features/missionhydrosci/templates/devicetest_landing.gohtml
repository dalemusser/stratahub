{{ define "devicetest_landing" }}
  {{ template "layout" . }}
{{ end }}

{{ define "content" }}
<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-200 mb-1">Mission HydroSci — Unit 2 Device Test</h1>
  <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
    This page checks whether a computer, Chromebook or iPad can download and run Mission HydroSci. It uses Unit 2, the largest unit, so a device that gets through it will handle the whole game.
  </p>

  {{ if not .Enabled }}
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
    <p class="text-gray-800 dark:text-gray-200">The device test is not enabled for this site right now.</p>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">If you were given this link by the Mission HydroSci team, let them know and they can turn it on.</p>
  </div>
  {{ else }}

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 mb-4 text-sm text-gray-700 dark:text-gray-300 space-y-2">
    <p><strong>What happens:</strong> the page downloads {{ .UnitTitle }} ({{ .SizeLabel }}), then launches it in the browser. Play through the opening part until the Unit 2 content has loaded and you are moving around in it; that is the important part, and finishing the unit is the full check. Use the device and network students will use.</p>
    <p><strong>What you need:</strong> a keyboard and a trackpad or mouse, because the game is controlled with them, and the sound turned on, because whether audio works on this device is one of the things we need to learn. Tell us about any sound problem in your report.</p>
    <p><strong>What is recorded:</strong> what you enter below, details about the device, browser, storage and network, every step of the download and launch (with timings and any errors), and the game's own progress data for this test run. Nothing is stored on the device beyond the game files, and no account is created.</p>
    <p><strong>Tips:</strong> keep this tab open until the download finishes, and if something goes wrong or sounds wrong, use <em>Send report</em> on the next page so we can see exactly where it stopped.</p>
  </div>

  {{ if .Error }}
  <div class="mb-4 rounded-md bg-red-50 dark:bg-red-900/30 px-3 py-2 text-sm text-red-700 dark:text-red-300">{{ .Error }}</div>
  {{ end }}

  <form method="post" action="/missionhydrosci/devicetest/start" class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 space-y-4">
    <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">School or district <span class="text-red-500">*</span></label>
        <input type="text" name="school" required maxlength="200" value="{{ .Form.School }}"
               class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Your name <span class="text-red-500">*</span></label>
        <input type="text" name="tester_name" required maxlength="200" value="{{ .Form.TesterName }}"
               class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Your role</label>
        <input type="text" name="tester_role" maxlength="200" value="{{ .Form.TesterRole }}" placeholder="teacher, IT, coordinator…"
               class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email (optional, so we can follow up)</label>
        <input type="email" name="tester_email" maxlength="200" value="{{ .Form.TesterEmail }}"
               class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Device</label>
        <select name="device_type" class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">
          {{ $dt := .Form.DeviceType }}
          <option value="" {{ if eq $dt "" }}selected{{ end }}>Choose…</option>
          <option value="Chromebook" {{ if eq $dt "Chromebook" }}selected{{ end }}>Chromebook</option>
          <option value="iPad" {{ if eq $dt "iPad" }}selected{{ end }}>iPad</option>
          <option value="Windows" {{ if eq $dt "Windows" }}selected{{ end }}>Windows laptop or desktop</option>
          <option value="macOS" {{ if eq $dt "macOS" }}selected{{ end }}>Mac</option>
          <option value="Android" {{ if eq $dt "Android" }}selected{{ end }}>Android tablet</option>
          <option value="Other" {{ if eq $dt "Other" }}selected{{ end }}>Other</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Is this a school-managed device?</label>
        <select name="managed_device" class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">
          {{ $md := .Form.ManagedDevice }}
          <option value="unknown" {{ if or (eq $md "") (eq $md "unknown") }}selected{{ end }}>Not sure</option>
          <option value="yes" {{ if eq $md "yes" }}selected{{ end }}>Yes</option>
          <option value="no" {{ if eq $md "no" }}selected{{ end }}>No</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Network</label>
        <select name="network_type" class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">
          {{ $nt := .Form.NetworkType }}
          <option value="" {{ if eq $nt "" }}selected{{ end }}>Choose…</option>
          <option value="school-wifi" {{ if eq $nt "school-wifi" }}selected{{ end }}>School Wi-Fi</option>
          <option value="school-wired" {{ if eq $nt "school-wired" }}selected{{ end }}>School wired network</option>
          <option value="home" {{ if eq $nt "home" }}selected{{ end }}>Home network</option>
          <option value="mobile" {{ if eq $nt "mobile" }}selected{{ end }}>Mobile hotspot / cellular</option>
          <option value="other" {{ if eq $nt "other" }}selected{{ end }}>Other</option>
        </select>
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notes (optional)</label>
      <textarea name="notes" rows="2" maxlength="2000" placeholder="Anything we should know: content filter in use, shared device, classroom size…"
                class="w-full border dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 p-2 rounded text-sm">{{ .Form.Notes }}</textarea>
    </div>
    <p class="text-xs text-gray-500 dark:text-gray-400">By starting the test you agree that the information above and the technical details of this run are recorded for the Mission HydroSci team.</p>
    <button type="submit" class="w-full sm:w-auto px-4 py-3 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">Start the Unit 2 test</button>
  </form>
  {{ end }}
</div>
{{ end }}
