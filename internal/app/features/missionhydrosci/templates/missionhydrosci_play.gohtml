{{ define "missionhydrosci_play" }}
<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ .UnitTitle }} - Mission HydroSci</title>
    <link rel="stylesheet" href="/assets/css/tailwind.css?v={{ tailwindVersion }}">
    <link rel="manifest" href="/manifest.json?v={{ missionhydrosciManifestVersion }}">
    <style>
      html, body {
        background: #000;
        width: 100%;
        height: 100%;
        overflow: visible;
        padding: 0;
        margin: 0;
      }
      #unity-container {
        background: transparent;
        position: absolute;
      }
      #unity-container canvas {
        position: absolute;
      }
      #loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #1e3a5f;
        color: white;
        font-family: sans-serif;
        z-index: 10;
      }
      #loading-overlay.hidden { display: none; }
      /* Notice bars (logging, offline): a slim bar over the bottom edge of the
         game (the top edge holds the back and fullscreen buttons), inside
         #unity-container so it survives fullscreen. Amber is right here: a bar
         only appears for a real problem, and the "!" mark keeps it readable
         without color. Only one bar shows at a time: while the device is
         offline the offline bar replaces the logging one. */
      .mhs-notice-bar {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        z-index: 30;
        background: rgba(120, 53, 15, 0.94);
        color: #fffbeb;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 13px;
        line-height: 1.35;
        padding: 6px 48px 6px 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.35);
      }
      .mhs-notice-bar[hidden] { display: none; }
      /* Shown through the Popover API the bar sits in the browser's top
         layer, above a fullscreen canvas (the game can fullscreen its own
         canvas, which would otherwise cover the bar). Undo the UA popover
         box and pin it to the viewport's bottom edge. */
      .mhs-notice-bar[popover] {
        position: fixed; top: auto; bottom: 0; left: 0; right: 0;
        width: auto; height: auto; max-width: none; margin: 0; border: 0;
        overflow: visible; inset-inline: 0;
      }
      .mhs-notice-bar .mhs-ln-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
      .mhs-notice-bar .mhs-ln-icon {
        flex: none; width: 18px; height: 18px; border-radius: 50%;
        background: #f59e0b; color: #451a03; font-weight: 700; font-size: 13px;
        display: inline-flex; align-items: center; justify-content: center;
      }
      .mhs-notice-bar .mhs-ln-text { flex: 1 1 260px; }
      .mhs-notice-bar .mhs-ln-btn {
        flex: none; background: rgba(255,255,255,0.14); color: #fffbeb;
        border: 1px solid rgba(255,255,255,0.35); border-radius: 4px;
        padding: 2px 8px; font: inherit; font-size: 12px; cursor: pointer;
      }
      .mhs-notice-bar .mhs-ln-btn:hover { background: rgba(255,255,255,0.24); }
      .mhs-notice-bar .mhs-ln-dismiss { position: absolute; top: 4px; right: 8px; font-size: 16px; line-height: 1; padding: 2px 7px; }
      .mhs-notice-bar .mhs-ln-how { margin: 6px 0 2px; padding: 8px 10px; background: rgba(0,0,0,0.25); border-radius: 6px; max-width: 720px; }
      .mhs-notice-bar .mhs-ln-how[hidden] { display: none; }
      .mhs-notice-bar .mhs-ln-how ol { margin: 4px 0 0 18px; padding: 0; }
      .mhs-notice-bar .mhs-ln-how li { margin: 3px 0; }
      .loading-bar-bg {
        width: 300px;
        height: 8px;
        background: rgba(255,255,255,0.2);
        border-radius: 4px;
        margin-top: 16px;
        overflow: hidden;
      }
      .loading-bar-fill {
        height: 100%;
        background: #60a5fa;
        border-radius: 4px;
        transition: width 0.3s;
      }
      #back-btn, #fullscreen-btn {
        position: fixed;
        top: 8px;
        z-index: 20;
        background: rgba(0,0,0,0.4);
        color: white;
        border: none;
        border-radius: 50%;
        /* >=44px hit target for touch (grades 6-9 on tablets). */
        width: 44px;
        height: 44px;
        font-size: 20px;
        line-height: 44px;
        text-align: center;
        cursor: pointer;
        opacity: 0.5;
        transition: opacity 0.2s;
        padding: 0;
        text-decoration: none;
      }
      #back-btn {
        left: 8px;
        display: none;
        align-items: center;
        justify-content: center;
        opacity: 0.7;
      }
      @media (display-mode: standalone) {
        #back-btn { display: flex; }
      }
      #fullscreen-btn { right: 8px; }
      #back-btn:hover, #fullscreen-btn:hover { opacity: 1; }

      /* Fullscreen sizing via CSS viewport units — bypasses iPad Safari's
         unreliable JS dimension reporting during fullscreen transitions.
         We fullscreen #unity-container (not <html>) so that keyboard
         events route directly to the container's subtree and reach the
         Unity canvas — fullscreening <html> causes browsers to intercept
         letter keys (W/A/S/D) at the document level.
         The canvas fills the entire screen — Unity WebGL renders to
         whatever canvas size it's given. No aspect ratio constraint
         so the game uses all available display space. */
      #unity-container:fullscreen,
      #unity-container:-webkit-full-screen {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: #000 !important;
      }
      #unity-container:fullscreen #unity-canvas,
      #unity-container:-webkit-full-screen #unity-canvas {
        width: 100vw !important;
        height: 100vh !important;
        top: 0 !important;
        left: 0 !important;
      }
    </style>
  </head>
  <body>
    <!-- Audio cleanup: track all AudioContext instances so we can close them
         when leaving the page. Must run before Unity loads (Unity creates
         AudioContexts via the Web Audio API for game audio). Without this,
         iOS PWA preserves the page in bfcache on navigation, and the
         AudioContexts keep playing in the background indefinitely. -->
    <script>
    (function() {
      var OrigAC = window.AudioContext || window.webkitAudioContext;
      if (!OrigAC) return;

      var tracked = [];
      window.__mhsAudioContexts = tracked;

      function TrackedAudioContext(options) {
        var ctx = options ? new OrigAC(options) : new OrigAC();
        tracked.push(ctx);

        // Shadow the native onstatechange property with a safe wrapper.
        // Unity's WEBAudio.audioContext.onstatechange handler calls
        // WEBAudio.audioInstances.forEach() which crashes when audioInstances
        // is an object (not an array) in some Unity versions. By intercepting
        // the setter, we wrap any handler in try-catch so the crash is
        // suppressed without affecting audio functionality.
        var _handler = null;
        Object.defineProperty(ctx, 'onstatechange', {
          configurable: true,
          enumerable: true,
          get: function() { return _handler; },
          set: function(fn) { _handler = fn; }
        });
        ctx.addEventListener('statechange', function(e) {
          if (_handler) {
            try { _handler.call(ctx, e); } catch (err) {
              console.warn('Suppressed audio statechange error:', err.message);
            }
          }
        });

        return ctx;
      }
      TrackedAudioContext.prototype = OrigAC.prototype;

      window.AudioContext = TrackedAudioContext;
      if (window.webkitAudioContext) {
        window.webkitAudioContext = TrackedAudioContext;
      }
    })();
    </script>

    <div id="unity-container">
      <a id="back-btn" href="{{ if .PlayBackURL }}{{ .PlayBackURL }}{{ else }}/missionhydrosci/units{{ end }}" title="{{ if .DeviceTest }}Done testing — back to the test page to answer the questions{{ else }}Back to Mission HydroSci{{ end }}" aria-label="{{ if .DeviceTest }}Done testing — back to the test page{{ else }}Back to Mission HydroSci{{ end }}"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="vertical-align: middle;" aria-hidden="true"><path d="M13 4 L7 10 L13 16" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <button id="fullscreen-btn" onclick="toggleFullscreen()" title="Fullscreen" aria-label="Toggle fullscreen">⛶</button>
      <div id="loading-overlay">
        <h2>Loading {{ .UnitTitle }}...</h2>
        <div class="loading-bar-bg">
          <div id="loading-bar" class="loading-bar-fill" style="width: 0%"></div>
        </div>
        <p id="loading-text" role="status" aria-live="polite" style="margin-top:8px; font-size:14px; opacity:0.7;">Initializing...</p>
        <p id="loading-step" style="margin-top:4px; font-size:12px; opacity:0.6;"></p>
        <p id="loading-hint" style="margin-top:8px; font-size:13px; opacity:0.85; max-width:min(560px, 92vw);"></p>
        <!-- The per-load step log; hidden until a launch step fails, then
             shown so the user can read and copy where it stopped. -->
        <div id="loading-steplog" style="display:none; margin-top:12px; width:min(560px, 92vw); text-align:left;">
          {{ template "mhs_steplog_panel" . }}
        </div>
      </div>
      <canvas id="unity-canvas" width="1400" height="800" tabindex="-1"></canvas>

      <!-- Logging notice. Shown when the server reports that no gameplay logs
           are arriving from this launch while the game runs, when the game
           says it cannot save its log cache, or when that cache's store is
           nearly full. The student's line is calm and the fix is for the
           teacher (docs/mission-hydrosci/mhs-game-logging-silent-failure-plan.md §5.1). -->
      <div id="mhs-logging-notice" class="mhs-notice-bar" role="status" aria-live="polite" hidden>
        <div class="mhs-ln-row">
          <span class="mhs-ln-icon" aria-hidden="true">!</span>
          <span class="mhs-ln-text" id="mhs-ln-text">Game activity is not being recorded on this device. You can keep playing. Please tell your teacher.</span>
          <button type="button" class="mhs-ln-btn" id="mhs-ln-how-btn" aria-expanded="false" aria-controls="mhs-ln-how">What to do</button>
          <button type="button" class="mhs-ln-btn mhs-ln-dismiss" id="mhs-ln-dismiss" aria-label="Hide this notice" title="Hide this notice">&times;</button>
        </div>
        <div class="mhs-ln-how" id="mhs-ln-how" hidden>
          <strong>For the teacher.</strong> The game is playing normally, but the record of this student's play is not reaching the research log. <span id="mhs-ln-reason"></span>
          <ol>
            <li>Let the student finish. Progress and settings are saved on the server and are not affected.</li>
            <li>When they are done, on this device clear the site data for this site: click the padlock (or the tune icon) in the browser's address bar, choose <em>Site settings</em>, then <em>Delete data</em>. This clears the game's stuck local log store.</li>
            <li>Sign the student in again and open the unit. The unit downloads again, so use good Wi-Fi.</li>
            <li>If this notice comes back on this device, the school network may be blocking the game's log service. Tell your program contact and name this device.</li>
          </ol>
          Details are in the Teacher Guide under "Game activity not recorded".
        </div>
      </div>

      <!-- Offline notice. The page's own heartbeats fail, so the device has
           lost its connection: the game keeps playing, but it cannot save
           progress online or send its activity record until the connection
           returns (it keeps the record on the device meanwhile). -->
      <div id="mhs-offline-notice" class="mhs-notice-bar" role="status" aria-live="polite" hidden>
        <div class="mhs-ln-row">
          <span class="mhs-ln-icon" aria-hidden="true">!</span>
          <span class="mhs-ln-text" id="mhs-off-text">This device has lost its internet connection. You can keep playing, but your game activity is not being recorded. Please tell your teacher.</span>
          <button type="button" class="mhs-ln-btn" id="mhs-off-how-btn" aria-expanded="false" aria-controls="mhs-off-how">What to do</button>
          <button type="button" class="mhs-ln-btn mhs-ln-dismiss" id="mhs-off-dismiss" aria-label="Hide this notice" title="Hide this notice">&times;</button>
        </div>
        <div class="mhs-ln-how" id="mhs-off-how" hidden>
          <strong>For the teacher.</strong> The game is playing normally, but this device cannot reach the internet. Progress cannot be saved online while it is offline, and the game's activity record stops for good once the connection has been gone for more than about ten seconds: it does not resume when the connection returns. <span id="mhs-off-detail"></span>
          <ol>
            <li>Check the device's Wi-Fi. If the whole class is affected, the network is down; the game keeps running on every device meanwhile.</li>
            <li>Keep the game tab open until the connection is back, so the game can save progress again.</li>
            <li>After the session, on this device, clear the site data for this site (padlock in the address bar, Site settings, Delete data) and sign the student in again. Until that is done the game will not record activity on this device, and the Devices tab will show it as Not recorded.</li>
          </ol>
        </div>
      </div>

      <!-- Help overlay (toggle with ? key, inside container so it's visible in fullscreen) -->
      <div id="help-overlay" role="dialog" aria-modal="true" aria-label="Game controls" style="
        display: none;
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.88); z-index: 90;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: white;
      ">
        <div style="
          position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
          max-width: 420px; width: 90%; padding: 2rem;
          background: rgba(30,58,95,0.95); border-radius: 12px;
          border: 1px solid rgba(255,255,255,0.15);
        ">
          <h2 style="margin: 0 0 0.5rem; font-size: 1.25rem; text-align: center; opacity: 0.95;">Game Controls</h2>
          <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
            <tr><td colspan="2" style="padding: 0.75rem 0 0.25rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.5;">Game</td></tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">W A S D</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Move</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">Trackpad / Mouse</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Look around</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">Space</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Jump</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">E</kbd> <span style="opacity: 0.6;">/</span> <svg width="18" height="22" viewBox="0 0 18 22" style="vertical-align: middle; display: inline-block;"><path d="M3 8 Q3 2 9 2 L9 10 L3 10 Z" fill="rgba(255,255,255,0.8)"/><path d="M9 2 Q15 2 15 8 L15 10 L9 10 Z" fill="rgba(255,255,255,0.15)"/><path d="M3 10 L3 15 Q3 20 9 20 Q15 20 15 15 L15 10 Z" fill="rgba(255,255,255,0.15)"/><path d="M3 8 Q3 2 9 2 Q15 2 15 8 L15 15 Q15 20 9 20 Q3 20 3 15 Z" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="1.5"/><line x1="9" y1="2" x2="9" y2="10" stroke="rgba(255,255,255,0.7)" stroke-width="1"/></svg></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Interact</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">H</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Hoverboard</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">M</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Map</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">Tab</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">DANI</td>
            </tr>
            <tr><td colspan="2" style="padding: 0.75rem 0 0.25rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.5;">Chromebook</td></tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 4px 8px; border-radius: 4px; font-size: 0.85rem;"><svg width="18" height="14" viewBox="0 0 18 14" style="vertical-align: middle; display: inline-block; margin-right: 4px;"><rect x="1" y="1" width="16" height="12" rx="1" fill="none" stroke="white" stroke-width="1.2"/><polygon points="3,3 3,7 7,3" fill="white"/><polygon points="15,11 15,7 11,11" fill="white"/></svg> Fullscreen key</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Enter / exit fullscreen</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">Esc</kbd> <span style="opacity: 0.6;">(hold 2s)</span></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Release mouse / exit fullscreen</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">Volume keys</kbd></td>
              <td style="padding: 0.4rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); opacity: 0.85;">Adjust volume</td>
            </tr>
            <tr>
              <td style="padding: 0.4rem 0.75rem; white-space: nowrap;"><kbd style="background: rgba(255,255,255,0.15); padding: 2px 8px; border-radius: 4px; font-size: 0.85rem;">←</kbd> <span style="opacity: 0.6;">(top-left)</span></td>
              <td style="padding: 0.4rem 0.75rem; opacity: 0.85;">Back to Mission HydroSci</td>
            </tr>
          </table>
          <p style="text-align: center; margin: 1.25rem 0 0; font-size: 0.8rem; opacity: 0.5;">Press <kbd style="background: rgba(255,255,255,0.15); padding: 1px 6px; border-radius: 3px;">?</kbd> to close</p>
        </div>
      </div>

      <!-- Unit complete overlay (hidden by default, inside container so it's visible in fullscreen) -->
      <div id="unit-complete-overlay" class="hidden" style="
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.85); z-index: 100;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        font-family: sans-serif; color: white; text-align: center;
      ">
        <h2 id="overlay-title" style="font-size: 1.5rem; margin-bottom: 0.5rem;">Unit Complete</h2>
        <p id="overlay-message" style="font-size: 1rem; opacity: 0.8; margin-bottom: 1rem;">Loading next unit...</p>
        <div id="overlay-download-bar" style="display: none; width: 240px; margin-bottom: 1.5rem;">
          <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.2); border-radius: 3px; overflow: hidden;">
            <div id="overlay-download-fill" style="height: 100%; background: #60a5fa; border-radius: 3px; transition: width 0.3s; width: 0%;"></div>
          </div>
          <p id="overlay-download-text" style="font-size: 0.75rem; opacity: 0.6; margin-top: 4px; text-align: center;">0%</p>
        </div>
      </div>
    </div>

    <!-- MHSBridge config: identity, services, and navigation injected server-side -->
    <script>
    (function() {
      // MHSBridge config — provides identity, service endpoints, and navigation
      // to the Unity game build via window.__mhsBridgeConfig.
      window.__mhsBridgeConfig = {
        identity: {
          user_id: '{{ .UserIDHex }}',
          name: '{{ .UserName }}'
        },
        services: {
          log_submit:    { url: '{{ .LogSubmitURL }}',    auth: '{{ .LogAuth }}' },
          state_save:    { url: '{{ .StateSaveURL }}',    auth: '{{ .SaveAuth }}' },
          state_load:    { url: '{{ .StateLoadURL }}',    auth: '{{ .SaveAuth }}' },
          settings_save: { url: '{{ .SettingsSaveURL }}', auth: '{{ .SaveAuth }}' },
          settings_load: { url: '{{ .SettingsLoadURL }}', auth: '{{ .SaveAuth }}' }
        },
        navigation: {}
      };

      console.log('MHSBridge config loaded for user_id:', window.__mhsBridgeConfig.identity.user_id || '(none)');
    })();
    </script>

    <!-- Block unit-to-unit transitions and handle completion -->
    <script src="/assets/js/mhs-steplog.js?v={{ mhsSteplogVersion }}"></script>
    <script src="/assets/js/mhs-delivery.js?v={{ mhsDeliveryVersion }}"></script>
    <script>
    (function() {
      var unitId = '{{ .UnitID }}';
      var csrfToken = '{{ .CSRFToken }}';
      var nextUnitId = '{{ .NextUnitID }}';
      var nextUnitVersion = '{{ .NextUnitVersion }}';
      var completionHandled = false;

      function isExternalGameUrl(url) {
        try {
          var parsed = new URL(url, window.location.origin);
          var host = parsed.hostname;
          return host !== window.location.hostname && (
            host.indexOf('adroit.games') !== -1 ||
            host.indexOf('cloudfront.net') !== -1
          );
        } catch (e) {
          return false;
        }
      }

      // Detect same-host unit transition URLs produced when MHSBridge operates in
      // URL mode: it navigates to ../unitN/index.html which resolves to
      // /missionhydrosci/unitN/index.html on the same host.
      function isUnitTransitionUrl(url) {
        try {
          var parsed = new URL(url, window.location.origin);
          return /\/missionhydrosci\/unit\d+\/index\.html/i.test(parsed.pathname);
        } catch (e) {
          return false;
        }
      }

      function shouldIntercept(url) {
        return isExternalGameUrl(url) || isUnitTransitionUrl(url);
      }

      {{ if .DeviceTest }}
      // Device test: there is no next unit and no progress record. Record the
      // completion on the run and show the "Test complete" screen with the
      // code the tester can quote back to us.
      var deviceTestBase = '{{ .DeviceTestBase }}';
      function deviceTestComplete() {
        var overlay = document.getElementById('unit-complete-overlay');
        var title = document.getElementById('overlay-title');
        var msg = document.getElementById('overlay-message');
        var bar = document.getElementById('overlay-download-bar');
        if (title) title.textContent = 'Test complete';
        if (msg) {
          msg.textContent = '';
          msg.appendChild(document.createTextNode('{{ .UnitTitle }} was finished on this device. Test code '));
          var code = document.createElement('strong');
          code.textContent = '{{ .DeviceTestShortID }}';
          msg.appendChild(code);
          msg.appendChild(document.createTextNode('. '));
          var link = document.createElement('a');
          link.href = deviceTestBase + '#questionnaire';
          link.textContent = 'Back to the test page to answer a few questions';
          link.style.color = '#93c5fd';
          link.style.textDecoration = 'underline';
          msg.appendChild(link);
        }
        if (bar) bar.style.display = 'none';
        if (overlay) overlay.classList.remove('hidden');
        if (window.__mhsStepLog && window.__mhsStepLog.flush) window.__mhsStepLog.flush(true);
        fetch(deviceTestBase + '/complete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: '{}',
          keepalive: true
        }).catch(function() {});
      }
      {{ end }}

      function handleUnitComplete() {
        if (completionHandled) return;
        completionHandled = true;
        if (window.__mhsStepLog) window.__mhsStepLog.record('game', 'ok', 'Unit complete reported by the game');
        {{ if .DeviceTest }}
        deviceTestComplete();
        return;
        {{ end }}

        // Show overlay immediately
        var overlay = document.getElementById('unit-complete-overlay');
        if (overlay) overlay.classList.remove('hidden');

        // Signal the units page (other tab) that progress changed.
        // Set this before the POST so even if the user switches tabs
        // immediately, the units page knows to reload for fresh state.
        try { localStorage.setItem('missionhydrosci-progress-changed', '1'); } catch (e) {}

        // POST completion to server
        fetch('/missionhydrosci/api/progress/complete', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          },
          body: JSON.stringify({ unit: unitId })
        })
        .then(function(resp) { return resp.json(); })
        .then(function(data) {
          completeAndTransition(data.next_unit, data.is_final);
        })
        .catch(function(err) {
          console.error('MHS: completion POST failed, queuing offline', err);
          // Offline fallback: store in queue, derive next unit locally
          queueCompletion(unitId);
          var isFinal = !nextUnitId;
          completeAndTransition(nextUnitId, isFinal);
        });
      }

      function completeAndTransition(nextUnit, isFinal) {
        if (isFinal || !nextUnit) {
          {{ if .CeremonyURL }}
          // Final unit, and the collection carries an end-of-game ceremony:
          // StrataHub owns the ending from here. Leave the game the moment it
          // reports the last unit complete and go straight to the ceremony —
          // no in-game end screen, no EndGame needed (a build that still
          // shows one is simply skipped). mhs-updates/end-of-game-ceremony-092426.
          cleanupUnity();
          window.location.href = '{{ .CeremonyURL }}';
          return;
          {{ end }}
          // Final unit — the game owns the end-of-game experience (its own end
          // screen / recap) and calls MHSBridge.EndGame() -> mhsEndGame() to
          // return to StrataHub when the player is ready. Unity is intentionally
          // left running.
          //
          // handleUnitComplete optimistically showed the "Loading next unit..."
          // overlay before we knew this was the last unit — it would otherwise
          // sit on top of the game's end screen forever (and cover the top-left
          // back button), trapping the student. Hide it so the end screen and
          // the back button are both reachable. This is correct for new builds
          // (EndGame exits) and old builds alike (the player uses Back).
          var overlay = document.getElementById('unit-complete-overlay');
          if (overlay) overlay.classList.add('hidden');
          return;
        }
        cleanupUnity();

        // Check if next unit is already cached
        var mgr = new MHSDeliveryManager({
          manifestUrl: '/missionhydrosci/api/manifest',
          contentPrefix: '/missionhydrosci/content/',
          unitCachePrefix: 'missionhydrosci-unit-',
          fetchIdPrefix: 'missionhydrosci-',
          csrfToken: csrfToken // enables download-error telemetry
        });
        if (window.__mhsStepLog) mgr.setStepLog(window.__mhsStepLog);

        mgr.refreshManifest().then(function() {
          // Unity is already torn down, so every branch from here MUST end in a
          // navigation — a branch that just returns strands the student on the
          // "Loading next unit..." overlay with no exit.
          if (!mgr.manifestLoaded) {
            // Couldn't load a fresh manifest (offline, or a server hiccup).
            // refreshManifest swallows the error and leaves an EMPTY manifest,
            // so isCached() below would wrongly say 'not_cached' even for a unit
            // that IS downloaded, and downloadUnit() would no-op. Instead go
            // straight to the next unit's play page: it is served network-first
            // from the SW cache, so a pre-downloaded unit plays offline, and if
            // it isn't downloaded that page surfaces the problem with its own
            // exit rather than hanging here.
            navigateToNext(nextUnit);
            return;
          }
          if (!mgr.manifest.units.find(function(u) { return u.id === nextUnit; })) {
            // Manifest loaded, but the next unit isn't in it — e.g. its build
            // record is missing so it was excluded, while server progress still
            // points at it. Its play page would 404; send the student to the
            // launcher, which always works.
            window.location.href = '/missionhydrosci/units';
            return;
          }
          return mgr.isCached(nextUnit).then(function(status) {
            if (status === 'cached') {
              // Auto-cleanup completed unit then navigate (navigate even if the
              // cleanup rejects — never strand).
              mgr.autoCleanup([nextUnit]).then(function() {
                navigateToNext(nextUnit);
              }, function() {
                navigateToNext(nextUnit);
              });
            } else {
              // Need to download — show progress on overlay
              showDownloadProgress(mgr, nextUnit);
            }
          });
        }).catch(function() {
          // Any unexpected failure — never strand; navigate.
          navigateToNext(nextUnit);
        });
      }

      function showDownloadProgress(mgr, nextUnit) {
        var msg = document.getElementById('overlay-message');
        var title = document.getElementById('overlay-title');
        if (title) title.textContent = 'Unit Complete';
        if (msg) msg.textContent = 'Downloading next unit...';

        // Show a progress bar in the overlay
        var bar = document.getElementById('overlay-download-bar');
        var barFill = document.getElementById('overlay-download-fill');
        var barText = document.getElementById('overlay-download-text');
        if (bar) bar.style.display = 'block';

        // Unity is already torn down by the time this overlay runs, so any
        // status the chain below doesn't resolve strands the student on a
        // frozen overlay with no exit. Every terminal state must navigate;
        // the play page's cache-miss path falls through to a CDN redirect,
        // so navigating is the correct degraded behavior when the download
        // didn't complete.
        var downloadStarted = false;   // gates 'not_cached'/'partial' — init fires them before the download begins
        var stallRedirectTimer = null; // one-shot exit for a 'stalled' that never recovers
        var redirecting = false;

        function clearStallRedirect() {
          if (stallRedirectTimer) {
            clearTimeout(stallRedirectTimer);
            stallRedirectTimer = null;
          }
        }

        function redirectSoon(message) {
          if (redirecting) return;
          redirecting = true;
          clearStallRedirect();
          if (msg) msg.textContent = message;
          setTimeout(function() { navigateToNext(nextUnit); }, 1500);
        }

        mgr.onStatus(function(uid, status, detail) {
          if (uid !== nextUnit) return;
          if (status === 'downloading') {
            downloadStarted = true;
            clearStallRedirect();
            var pct = detail.percent || 0;
            var waitNote = '';
            if (detail.note) {
              waitNote = ' \u2014 ' + detail.note;
            } else if (detail.waitingMs >= 5000) {
              waitNote = ' \u2014 no data for ' + Math.round(detail.waitingMs / 1000) + ' s';
              if (typeof detail.switchInMs === 'number') waitNote += ', switching to direct download in ' + Math.round(detail.switchInMs / 1000) + ' s';
              else if (typeof detail.resumeInMs === 'number') waitNote += ', resuming in ' + Math.round(detail.resumeInMs / 1000) + ' s';
            }
            if (msg) msg.textContent = 'Downloading next unit... ' + pct + '%' + waitNote;
            if (barFill) barFill.style.width = pct + '%';
            if (barText) barText.textContent = pct + '%';
          } else if (status === 'cached') {
            clearStallRedirect();
            if (msg) msg.textContent = 'Ready!';
            if (barFill) barFill.style.width = '100%';
            // Cleanup completed unit then navigate
            mgr.autoCleanup([nextUnit]).then(function() {
              navigateToNext(nextUnit);
            });
          } else if (status === 'stalled') {
            // The download may still be running — inform, don't abort. But a
            // dead download never emits another status ('stalled' fires only
            // once), so arm a one-shot exit: if nothing progresses within
            // 30s, treat it like the error path and navigate.
            if (msg) msg.textContent = 'Download stalled — still trying...';
            if (!stallRedirectTimer) {
              stallRedirectTimer = setTimeout(function() {
                redirectSoon('Download stalled. Redirecting...');
              }, 30000);
            }
          } else if (status === 'error') {
            redirectSoon('Download failed. Redirecting...');
          } else if ((status === 'not_cached' || status === 'partial') && downloadStarted) {
            // A canceled fallback loop or a cross-tab delete surfaced
            // mid-download; tracking is cleared, no further status will come.
            redirectSoon('Download interrupted. Redirecting...');
          }
        });

        // Need full SW init for Background Fetch
        mgr._swUrl = '/sw.js';
        mgr._swScope = '/';
        mgr._channelName = 'missionhydrosci-delivery';
        mgr.init().then(function() {
          mgr.downloadUnit(nextUnit);
        }).catch(function() {
          // SW registration / init failed — don't strand on the overlay.
          redirectSoon('Could not start the download. Redirecting...');
        });
      }

      function navigateToNext(nextUnit) {
        window.location.href = '/missionhydrosci/play/' + nextUnit;
      }

      function queueCompletion(unitId) {
        var key = 'mhs-progress-queue';
        var queue = JSON.parse(localStorage.getItem(key) || '[]');
        queue.push({ unit: unitId, timestamp: new Date().toISOString() });
        localStorage.setItem(key, JSON.stringify(queue));
      }

      // MHSBridge callback — the game calls this via jslib when a unit is completed.
      // This is the primary completion signal (Phase 4).
      window.mhsUnitComplete = function(completedUnitId) {
        console.log('MHS: mhsUnitComplete called with', completedUnitId);
        handleUnitComplete();
      };

      // MHSBridge callback — the game calls this when the player has finished
      // the game and is ready to exit (from the end-of-game screen).
      // New in April 2026 MHSBridge update. Older builds don't call this —
      // the player uses the back button instead (the units page then offers
      // the ceremony once the student is complete).
      // When the collection carries an end-of-game ceremony this lands on it
      // (docs/mission-hydrosci/mhs-end-ceremony-plan.md D6); otherwise the launcher.
      //
      // The end screen means the last unit is done, but the shipped build
      // (2.8.1) calls only EndGame at the end of Unit 5 — never CompleteUnit
      // for it — so the student's progress stayed on unit5 and the ceremony's
      // gate sent them back to the launcher (2026-09-24). Record the
      // completion here before leaving; when a build does call CompleteUnit
      // first, completionHandled is already set and this just navigates.
      // TODO: Remove backward compatibility note once all builds use the new MHSBridge.
      window.mhsEndGame = function() {
        console.log('MHS: mhsEndGame called — leaving the game');
        var target = '{{ if .CeremonyURL }}{{ .CeremonyURL }}{{ else if .PlayBackURL }}{{ .PlayBackURL }}{{ else }}/missionhydrosci/units{{ end }}';
        {{ if .DeviceTest }}
        window.location.href = target;
        return;
        {{ end }}
        if (completionHandled) { window.location.href = target; return; }
        completionHandled = true;
        if (window.__mhsStepLog) window.__mhsStepLog.record('game', 'ok', 'Game end reported by the game; recording the unit as complete');
        try { localStorage.setItem('missionhydrosci-progress-changed', '1'); } catch (e) {}
        var left = false;
        var leave = function() { if (left) return; left = true; window.location.href = target; };
        // Never strand the student on the end screen: if the completion POST
        // has not answered in 8 s, queue it (the launcher flushes the queue)
        // and go; the ceremony page sends a not-yet-complete student to the
        // launcher, which is where they would end up anyway.
        var timer = setTimeout(function() { queueCompletion(unitId); leave(); }, 8000);
        fetch('/missionhydrosci/api/progress/complete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ unit: unitId }),
          keepalive: true
        })
        .then(function(resp) { if (!resp.ok) { throw new Error('HTTP ' + resp.status); } return resp.json(); })
        .then(function() { clearTimeout(timer); leave(); })
        .catch(function(err) {
          console.error('MHS: end-game completion POST failed, queuing offline', err);
          clearTimeout(timer);
          queueCompletion(unitId);
          leave();
        });
      };

      // Expose for cleanup script
      window.__mhsHandleUnitComplete = handleUnitComplete;

      // Navigation API (Chrome 102+ / Chromebooks) — intercepts window.location changes
      if (window.navigation) {
        navigation.addEventListener('navigate', function(event) {
          if (shouldIntercept(event.destination.url)) {
            event.preventDefault();
            console.log('MHS: blocked navigation to', event.destination.url);
            handleUnitComplete();
          }
        });
      }

      // Also intercept window.open (used by Unity's Application.OpenURL)
      var _windowOpen = window.open;
      window.open = function(url) {
        if (shouldIntercept(url)) {
          console.log('MHS: blocked window.open to', url);
          handleUnitComplete();
          return null;
        }
        return _windowOpen.apply(this, arguments);
      };
    })();
    </script>

    <style>
      #unit-complete-overlay.hidden { display: none !important; }
    </style>

    <script>
    (function() {
      var unitId = '{{ .UnitID }}';
      var unitVersion = '{{ .UnitVersion }}';
      // Renewable CSRF token for every post this script makes (log streaming,
      // summary, heartbeats, member launch records); see MHSStepLog.csrf.
      // It must live in THIS scope: each <script> block is its own function.
      var csrf = MHSStepLog.csrf('{{ .CSRFToken }}', window.location.pathname);
      // Files are served from /missionhydrosci/content/{unit}/v{version}/
      // The service worker intercepts these and serves from cache or falls through to CDN redirect.
      var contentUrl = '/missionhydrosci/content/' + unitId + '/v' + unitVersion;
      var buildUrl = contentUrl + '/Build';
      var loaderUrl = buildUrl + '/' + unitId + '.loader.js';

      // Per-load step log (continues the units page's log in this tab).
      var stepLog = new MHSStepLog();
      {{ if .DeviceTest }}
      if (stepLog.context.testId !== '{{ .DeviceTestID }}') stepLog.reset();
      {{ else }}
      if (stepLog.context.testId) stepLog.reset(); // a device-test run's log left in this tab is not this student's
      {{ end }}
      stepLog.start({
        page: {{ if .DeviceTest }}'devicetest-play'{{ else }}'play'{{ end }},
        host: location.host,
        workspace: location.hostname.split('.')[0],
        unit: unitId,
        version: unitVersion,
        unitTitle: '{{ .UnitTitle }}',
        {{ if .DeviceTest }}testId: '{{ .DeviceTestID }}',{{ end }}
        deviceId: (function() { try { return localStorage.getItem('mhs-device-id') || ''; } catch (e) { return ''; } })(),
        userAgent: navigator.userAgent,
        deliveryVersion: '{{ mhsDeliveryVersion }}',
        steplogVersion: '{{ mhsSteplogVersion }}'
      });
      window.__mhsStepLog = stepLog; // shared with the completion overlay's manager
      var stepPanel = MHSStepLog.mount(stepLog, document.getElementById('mhs-steplog'), {});
      {{ if .DeviceTest }}
      // Device test: stream the log and the launch timings to the run record.
      stepLog.enableServerFlush('{{ .DeviceTestBase }}/steps', csrf.get, 5000, { onForbidden: csrf.refresh });
      stepLog.relayTo(MHSStepLog.relayChannel('{{ .DeviceTestID }}'), 'game tab'); // the run page's panel follows along
      var deviceTestLoaderMs = 0;
      function deviceTestSummary(body) {
        try {
          csrf.fetch('{{ .DeviceTestBase }}/summary', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            keepalive: true
          }).catch(function() {});
        } catch (e) { /* best effort */ }
      }
      function memberReport() { /* device test: the log streams to the run instead */ }
      {{ else }}
      // Member launches: store the step log on a launch outcome (plan step A2)
      // so a field report can be read step by step in the Device Tests view.
      var memberReported = {};
      var launchRecordRetry = null;
      function memberReport(outcome) {
        if (memberReported[outcome]) return;
        memberReported[outcome] = true;
        try {
          csrf.fetch('/missionhydrosci/api/steplog', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ outcome: outcome, unit: unitId, version: unitVersion, context: stepLog.context, entries: stepLog.entries.slice(-300) }),
            keepalive: true
          }).then(function(resp) {
            if (outcome === 'launch-ok') onHeartbeatReached(); // the server answered: online
            return resp.ok ? resp.json() : null;
          }).then(function(data) {
            // The launch record is where this launch's heartbeats go.
            if (outcome === 'launch-ok' && data && data.id) {
              heartbeatUrl = '/missionhydrosci/api/steplog/' + data.id + '/heartbeat';
              startHeartbeat();
            }
          }).catch(function() {
            // No answer at all: the device is offline (a unit launched from
            // its cached files with the network already down). Without the
            // launch record no heartbeat runs, so nothing would ever notice;
            // count it as a failed beat and keep trying every 30 s until the
            // record exists, then the heartbeats take over.
            if (outcome !== 'launch-ok') return;
            memberReported[outcome] = false;
            onHeartbeatFailed();
            if (!launchRecordRetry) launchRecordRetry = setTimeout(function() { launchRecordRetry = null; memberReport('launch-ok'); }, 30000);
          });
        } catch (e) { /* best effort */ }
      }
      {{ end }}
      var loadingStepEl = document.getElementById('loading-step');
      stepLog.onChange(function(entry) {
        if (!entry || !loadingStepEl) return;
        loadingStepEl.textContent = (MHSStepLog.STEP_LABELS[entry.step] || entry.step) + ': ' + entry.msg;
      });
      function showStepLogOnFailure() {
        var wrap = document.getElementById('loading-steplog');
        if (wrap) wrap.style.display = 'block';
        if (stepPanel) stepPanel.open();
      }
      var launchStartedAt = Date.now();
      var lastMilestone = -1;

      // Heartbeat: memory, frame rate and visibility every 30 s while the
      // game runs, and a final "closing" beat on pagehide. A renderer crash
      // ("Aw, Snap") kills the page with nothing left to report, so the trend
      // up to the last beat is the evidence; the server marks a run whose
      // beats stop without a closing beat as "page stopped responding".
      var hbFrames = 0, hbLastAt = Date.now(), hbTimer = null;
      var heartbeatUrl = {{ if .DeviceTest }}'{{ .DeviceTestBase }}/heartbeat'{{ else }}''{{ end }}; // members: set once the launch record exists
      (function countFrames() { hbFrames++; requestAnimationFrame(countFrames); })();
      function heartbeatBody(closing) {
        var now = Date.now();
        var secs = Math.max(0.001, (now - hbLastAt) / 1000);
        var body = {
          phase: 'game',
          elapsed_ms: now - launchStartedAt,
          visibility: document.visibilityState,
          fps: Math.round((hbFrames / secs) * 10) / 10,
          closing: !!closing,
          // Logging health (see loggingHealth below): the size of the game's
          // PlayerPrefs store and how many cache-write failures the game has
          // printed. The reply carries the server's own verdict.
          playerprefs_bytes: (typeof loggingHealth.prefsBytes === 'number') ? loggingHealth.prefsBytes : 0,
          cache_errors: loggingHealth.cacheErrors,
          // Cumulative time this page has seen the device offline (its own
          // beats failing); only ever delivered once the connection is back.
          offline_ms: netHealth.offlineMs + (netHealth.offlineSince ? (now - netHealth.offlineSince) : 0)
        };
        hbFrames = 0; hbLastAt = now;
        try {
          if (performance.memory) {
            body.js_heap_mb = Math.round(performance.memory.usedJSHeapSize / 1048576);
            body.js_heap_total_mb = Math.round(performance.memory.totalJSHeapSize / 1048576);
          }
        } catch (e) { /* not available */ }
        try {
          var M = window.__unityInstance && window.__unityInstance.Module;
          var buf = M && ((M.HEAPU8 && M.HEAPU8.buffer) || (M.wasmMemory && M.wasmMemory.buffer));
          if (buf) body.wasm_heap_mb = Math.round(buf.byteLength / 1048576);
        } catch (e) { /* not available */ }
        return body;
      }
      function sendHeartbeat(closing) {
        if (!heartbeatUrl) return;
        try {
          csrf.fetch(heartbeatUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(heartbeatBody(closing)),
            keepalive: !!closing
          }).then(function(resp) {
            if (!closing) onHeartbeatReached(); // the server answered: the device is online, whatever the status
            if (closing || !resp || !resp.ok) return null;
            return resp.json().catch(function() { return null; });
          }).then(function(data) {
            if (data && data.logs) onLogsState(data.logs);
          }).catch(function() {
            // A rejected fetch is a network failure (no server answer at all).
            if (!closing) onHeartbeatFailed();
          });
        } catch (e) { /* best effort */ }
      }
      function startHeartbeat() {
        if (hbTimer || !heartbeatUrl) return;
        hbTimer = setInterval(function() { sendHeartbeat(false); }, 30000);
        sendHeartbeat(false);
      }
      window.addEventListener('pagehide', function() { if (hbTimer) sendHeartbeat(true); });
      function loaderSource() {
        try {
          var abs = new URL(loaderUrl, location.href).href;
          var entries = performance.getEntriesByName(abs);
          if (entries && entries.length) {
            var e = entries[entries.length - 1];
            if (e.transferSize === 0 && e.decodedBodySize > 0) return ' (from the downloaded files)';
            if (e.transferSize > 0) return ' (from the network)';
          }
        } catch (e) { /* not available */ }
        return '';
      }

      // Register this play session so the units page's stale-cache prune
      // won't delete this unit's cache out from under the running game —
      // a content deploy can bump the version mid-session, making this
      // cache "stale" while the game is still reading it. The heartbeat
      // protocol (key, TTL, visibility re-arm) lives in mhs-delivery.js.
      var mhsStopPlayHeartbeat = MHSDeliveryManager.startPlayHeartbeat(unitId, unitVersion);
      window.addEventListener('pagehide', function() {
        mhsStopPlayHeartbeat();
      });

      var canvas = document.getElementById('unity-canvas');
      var loadingBar = document.getElementById('loading-bar');
      var loadingText = document.getElementById('loading-text');
      var loadingHint = document.getElementById('loading-hint');
      var loadingOverlay = document.getElementById('loading-overlay');

      // --- Crash reporting ---
      var crashPhase = 'loading'; // tracks current phase: loading, compiling, running
      var crashReported = false;  // prevent duplicate reports

      function reportCrash(type, message, stack, phase) {
        if (crashReported) return;
        crashReported = true;
        stepLog.record('game', 'fail', 'Crash (' + (type || 'unknown') + ', ' + (phase || crashPhase) + '): ' +
          String(message || '').slice(0, 200));
        if ((phase || crashPhase) !== 'running') showStepLogOnFailure();
        {{ if .DeviceTest }}deviceTestSummary({ crash: true });{{ end }}
        memberReport('crash');

        var logUrl = '{{ .LogSubmitURL }}';
        var logAuth = '{{ .LogAuth }}';
        if (!logUrl) { console.warn('MHS crash: no log endpoint configured'); return; }

        // Match the device format used by Unity game log events
        var device = {
          os: navigator.platform || '',
          platform: 'UnityWebGL',
          processors: navigator.hardwareConcurrency || 0,
          memory: navigator.deviceMemory ? navigator.deviceMemory * 1024 : 0,
          resolution: {
            width: screen.width || 0,
            height: screen.height || 0
          },
          userAgent: navigator.userAgent || '',
          online: navigator.onLine
        };
        if (performance && performance.memory) {
          device.jsHeapUsedMB = Math.round(performance.memory.usedJSHeapSize / 1048576);
          device.jsHeapTotalMB = Math.round(performance.memory.totalJSHeapSize / 1048576);
        }

        var payload = {
          game: 'mhs',
          user_id: '{{ .UserIDHex }}',
          eventType: 'crash',
          version: unitVersion,
          data: {
            type: type || 'unknown',
            message: String(message || '').substring(0, 2000),
            stack: String(stack || '').substring(0, 4000),
            phase: phase || crashPhase,
            unitId: unitId,
            workspace: window.location.hostname.split('.')[0],
            isPWA: !!(navigator.serviceWorker && navigator.serviceWorker.controller)
          },
          device: device
        };

        var body = JSON.stringify(payload);
        console.error('MHS crash report:', payload);

        // Use fetch with keepalive for reliability during page unload.
        // sendBeacon can't set Authorization headers and triggers CORS issues.
        try {
          fetch(logUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': logAuth },
            body: body,
            keepalive: true
          }).catch(function() {});
        } catch (e) {
          // keepalive fetch may throw if body is too large (64KB limit)
          fetch(logUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': logAuth },
            body: body
          }).catch(function() {});
        }
      }

      window.onerror = function(message, source, lineno, colno, error) {
        reportCrash('runtime_error', message, error && error.stack ? error.stack : (source + ':' + lineno + ':' + colno), crashPhase);
      };

      window.onunhandledrejection = function(event) {
        var reason = event.reason || {};
        reportCrash('unhandled_rejection', reason.message || String(reason), reason.stack || '', crashPhase);
      };

      // ---- Logging health ------------------------------------------------
      // The game says nothing to anyone when its gameplay logging fails
      // (docs/mission-hydrosci/mhs-game-logging-silent-failure-plan.md §2), so
      // three signals are watched here and shown as one calm notice:
      //  1. the heartbeat reply: the server checks whether the log service is
      //     receiving this launch's entries ("none" after a few minutes of
      //     play is the silent failure itself);
      //  2. the game's own console error when it cannot write its log cache
      //     (its PlayerPrefs store is full or unwritable);
      //  3. the size of that store, read from IndexedDB, nearly at Unity's
      //     1 MB cap.
      var loggingHealth = { cacheErrors: 0, prefsBytes: null, state: '', shown: '', dismissed: {}, warnedFull: false };
      var lnEl = document.getElementById('mhs-logging-notice');
      var lnHow = document.getElementById('mhs-ln-how');
      var lnHowBtn = document.getElementById('mhs-ln-how-btn');
      var lnReason = document.getElementById('mhs-ln-reason');
      var lnReasons = {
        none: 'StrataHub has been watching this session and no gameplay logs have arrived from it.',
        cache: 'The game reported that it can no longer save its log cache on this device (the store is full).',
        full: 'The game’s local log store on this device is nearly full, which means logs have been piling up unsent for a long time.'
      };
      if (lnHowBtn) lnHowBtn.addEventListener('click', function() {
        var open = lnHow.hidden;
        lnHow.hidden = !open;
        lnHowBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        lnHowBtn.textContent = open ? 'Hide' : 'What to do';
      });
      var lnDismiss = document.getElementById('mhs-ln-dismiss');
      if (lnDismiss) lnDismiss.addEventListener('click', function() {
        loggingHealth.dismissed[loggingHealth.shown] = true;
        hideLoggingNotice();
      });
      // Show a bar in the browser's top layer when the Popover API exists, so
      // it stays above a fullscreen canvas; plain visibility otherwise.
      function barShow(el) {
        if (!el) return;
        el.hidden = false;
        if (typeof el.showPopover !== 'function') return;
        try {
          if (!el.hasAttribute('popover')) el.setAttribute('popover', 'manual');
          if (!el.matches(':popover-open')) el.showPopover();
        } catch (e) { /* fall back to plain visibility */ }
      }
      function barHide(el) {
        if (!el) return;
        try { if (typeof el.hidePopover === 'function' && el.matches(':popover-open')) el.hidePopover(); } catch (e) {}
        el.hidden = true;
      }
      // A later top-layer entrant paints above an earlier one: when
      // fullscreen changes, re-raise any bar that is showing.
      ['fullscreenchange', 'webkitfullscreenchange'].forEach(function(ev) {
        document.addEventListener(ev, function() {
          [document.getElementById('mhs-logging-notice'), document.getElementById('mhs-offline-notice')].forEach(function(el) {
            if (el && !el.hidden && typeof el.showPopover === 'function') {
              try { if (el.matches(':popover-open')) el.hidePopover(); el.showPopover(); } catch (e) {}
            }
          });
        });
      });
      function showLoggingNotice(reason) {
        if (!lnEl || loggingHealth.dismissed[reason]) return;
        if (loggingHealth.shown === reason) return;
        loggingHealth.shown = reason;
        if (lnReason) lnReason.textContent = lnReasons[reason] || '';
        barShow(lnEl);
      }
      function hideLoggingNotice() {
        if (!lnEl) return;
        barHide(lnEl);
        if (lnHow) lnHow.hidden = true;
        if (lnHowBtn) { lnHowBtn.setAttribute('aria-expanded', 'false'); lnHowBtn.textContent = 'What to do'; }
        loggingHealth.shown = '';
      }
      // 1. The server's verdict, from the heartbeat reply.
      var lnStateLogged = {};
      function onLogsState(state) {
        loggingHealth.state = state;
        if (state === 'none') {
          if (!lnStateLogged.none) {
            lnStateLogged.none = true;
            stepLog.record('game', 'warn', 'No gameplay logs are reaching the server from this session — the game is playing but its activity is not being recorded on this device');
          }
          showLoggingNotice('none');
        } else if (state === 'seen') {
          if (loggingHealth.shown === 'none') {
            stepLog.record('game', 'ok', 'Gameplay logs are reaching the server again');
            hideLoggingNotice();
          }
          if (!lnStateLogged.seen) { lnStateLogged.seen = true; stepLog.record('game', 'info', 'Gameplay logs are reaching the server'); }
        } else if (state === 'quiet') {
          // Nothing has arrived, but the game has not produced any activity
          // to send either (a menu screen, a paused tab): not a failure.
          if (!lnStateLogged.quiet) { lnStateLogged.quiet = true; stepLog.record('game', 'info', 'No gameplay logs yet, and the game has produced no activity to record so far (normal at a menu screen)'); }
        }
      }
      // 2. The game's console error. Installed before the loader runs; calls
      //    the original first so nothing else changes.
      (function hookConsoleError() {
        var orig = console.error;
        if (typeof orig !== 'function') return;
        console.error = function() {
          try {
            var first = arguments.length ? String(arguments[0]) : '';
            if (first.indexOf('Failed to save cached logs') !== -1 || first.indexOf('Failed to load cached logs') !== -1) onGameLogCacheError(first);
          } catch (e) { /* never interfere with the game's output */ }
          return orig.apply(console, arguments);
        };
      })();
      function onGameLogCacheError(message) {
        loggingHealth.cacheErrors++;
        if (loggingHealth.cacheErrors === 1) {
          stepLog.record('game', 'warn', 'The game cannot save its log cache on this device (' + String(message).slice(0, 120) + ') — gameplay logs are not being recorded here');
          showLoggingNotice('cache');
          if (hbTimer) sendHeartbeat(false); // let the server record it now rather than at the next beat
        }
      }
      // 3. The store's size: once before the game starts (the step log gets
      //    the figure), then once a minute while it runs.
      function readUnityPrefs(first) {
        MHSStepLog.readUnityPrefsBytes().then(function(bytes) {
          if (typeof bytes !== 'number') return;
          loggingHealth.prefsBytes = bytes;
          var pct = Math.round(bytes * 100 / MHSStepLog.UNITY_PREFS_CAP);
          if (first && bytes > 0) {
            stepLog.record('storage', pct >= 90 ? 'warn' : 'info', 'Game log cache store: ' + MHSStepLog.unityPrefsText(bytes) +
              (pct >= 90 ? ' — nearly full: gameplay logs have been piling up unsent on this device' : ''));
          }
          if (pct >= 95 && !loggingHealth.warnedFull) {
            loggingHealth.warnedFull = true;
            if (!first) stepLog.record('storage', 'warn', 'Game log cache store nearly full: ' + MHSStepLog.unityPrefsText(bytes));
            showLoggingNotice('full');
          }
        }).catch(function() {});
      }
      readUnityPrefs(true);
      setInterval(function() { readUnityPrefs(false); }, 60000);

      // ---- Offline ----------------------------------------------------------
      // The one case the server cannot see: with no network, no heartbeat
      // arrives and no verdict comes back. The page's own failing beats are
      // the signal. The game keeps playing but cannot save progress online,
      // and an outage of more than about ten seconds kills its logging for
      // good (see the plan). Two failed beats in a row (about a minute), or
      // the browser's own offline event, show the offline bar; the first
      // answered beat clears it, after which the logging check reports the
      // dead sender within a few minutes.
      var netHealth = { failures: 0, offlineSince: 0, offlineMs: 0, shown: false, loggingWasShown: '' };
      var offEl = document.getElementById('mhs-offline-notice');
      var offHow = document.getElementById('mhs-off-how');
      var offHowBtn = document.getElementById('mhs-off-how-btn');
      var offDetail = document.getElementById('mhs-off-detail');
      if (offHowBtn) offHowBtn.addEventListener('click', function() {
        var open = offHow.hidden;
        offHow.hidden = !open;
        offHowBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        offHowBtn.textContent = open ? 'Hide' : 'What to do';
      });
      var offDismiss = document.getElementById('mhs-off-dismiss');
      if (offDismiss) offDismiss.addEventListener('click', function() { barHide(offEl); });
      function showOffline() {
        if (netHealth.shown) return;
        netHealth.shown = true;
        if (!netHealth.offlineSince) netHealth.offlineSince = Date.now();
        stepLog.record('game', 'warn', 'Connection lost — the game keeps playing, but progress cannot be saved online and the activity record stays on this device until the connection returns');
        if (offDetail) {
          var kept = (typeof loggingHealth.prefsBytes === 'number' && loggingHealth.prefsBytes > 1024)
            ? ' About ' + Math.round(loggingHealth.prefsBytes / 1024) + ' KB of unsent activity is sitting on this device.' : '';
          offDetail.textContent = 'Lost at ' + new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) + '.' + kept;
        }
        // The offline bar explains everything the logging bar would; show one.
        if (loggingHealth.shown) { netHealth.loggingWasShown = loggingHealth.shown; hideLoggingNotice(); }
        barShow(offEl);
      }
      function hideOffline() {
        if (!netHealth.shown) return;
        netHealth.shown = false;
        var mins = netHealth.offlineSince ? Math.round((Date.now() - netHealth.offlineSince) / 60000) : 0;
        stepLog.record('game', 'ok', 'Connection back' + (mins ? ' after about ' + mins + ' min' : ''));
        barHide(offEl);
        if (offHow) offHow.hidden = true;
        if (offHowBtn) { offHowBtn.setAttribute('aria-expanded', 'false'); offHowBtn.textContent = 'What to do'; }
        if (netHealth.loggingWasShown) { var was = netHealth.loggingWasShown; netHealth.loggingWasShown = ''; showLoggingNotice(was); }
      }
      function onHeartbeatFailed() {
        netHealth.failures++;
        if (!netHealth.offlineSince) netHealth.offlineSince = Date.now();
        if (netHealth.failures >= 2 || navigator.onLine === false) showOffline();
      }
      function onHeartbeatReached() {
        netHealth.failures = 0;
        if (netHealth.offlineSince) { netHealth.offlineMs += Date.now() - netHealth.offlineSince; netHealth.offlineSince = 0; }
        hideOffline();
      }
      window.addEventListener('offline', function() {
        // The browser is sure: show at once rather than after two beats.
        if (!netHealth.offlineSince) netHealth.offlineSince = Date.now();
        showOffline();
      });
      window.addEventListener('online', function() {
        // Not proof by itself; let a beat confirm it. If the launch record
        // never got created (network down at launch), try it now.
        if (hbTimer) sendHeartbeat(false);
        else if (typeof memberReported !== 'undefined' && !memberReported['launch-ok']) {
          if (launchRecordRetry) { clearTimeout(launchRecordRetry); launchRecordRetry = null; }
          memberReport('launch-ok');
        }
      });
      // Already offline when the page opened (a unit launched from its
      // cached files with the network down): no transition event will come,
      // so say so now rather than after the first failures.
      if (navigator.onLine === false) showOffline();

      // Aspect-ratio-preserving resize (matches dev build: 1400x800, 7:4 ratio).
      // In fullscreen mode, CSS handles sizing via viewport units (see <style> above)
      // to avoid iPad Safari's unreliable JS dimension reporting. This JS path
      // only runs for normal (non-fullscreen) mode.
      var scaleToFit = true;

      function isFullscreenActive() {
        return !!(document.fullscreenElement || document.webkitFullscreenElement);
      }

      function onResize() {
        // In fullscreen, CSS viewport units handle sizing reliably
        if (isFullscreenActive()) return;

        var container = canvas.parentElement;
        var w, h;

        if (scaleToFit) {
          w = window.innerWidth;
          h = window.innerHeight;
          var r = 800 / 1400;

          if (w * r > h) {
            w = Math.min(w, Math.ceil(h / r));
          }
          h = Math.floor(w * r);
        } else {
          w = 1400;
          h = 800;
        }

        container.style.width = canvas.style.width = w + 'px';
        container.style.height = canvas.style.height = h + 'px';
        container.style.top = Math.floor((window.innerHeight - h) / 2) + 'px';
        container.style.left = Math.floor((window.innerWidth - w) / 2) + 'px';
      }

      window.addEventListener('resize', onResize);
      // Expose onResize for the fullscreen handlers, which live OUTSIDE this
      // IIFE (toggleFullscreen / onFullscreenChange). Calling onResize directly
      // from there threw a ReferenceError on every fullscreen exit — which both
      // skipped the keyboard refocus (WASD dead until the canvas is clicked) and
      // tripped window.onerror -> reportCrash, permanently setting
      // crashReported = true and suppressing every real crash report after.
      // The reference keeps this closure, so it still sees the reassigned canvas.
      window.__mhsResize = onResize;
      onResize();

      // Mobile viewport
      if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        var meta = document.createElement('meta');
        meta.name = 'viewport';
        meta.content = 'width=device-width, height=device-height, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes';
        document.getElementsByTagName('head')[0].appendChild(meta);
      }

      // Launch watchdog. A launch that stops making progress used to sit at
      // "Initializing…" forever and report nothing. Now, 30 s without
      // progress logs what the page was doing, probes whether the loader
      // file can be fetched at all, shows the panel, stores a load record
      // and tells the tester what to try. At 90 s, if the loader script
      // itself never arrived (typically a wedged service worker), the page
      // tries again straight from the content server, bypassing the
      // worker; otherwise, or if that also stalls, it marks the launch
      // failed with the reset steps. Never a reload loop.
      var WATCHDOG_WARN_MS = 30000, WATCHDOG_ESCALATE_MS = 90000;
      var launchPhase = 'loader';
      var lastLaunchProgressAt = Date.now();
      var watchdogWarned = false, watchdogFailed = false, watchdogTimer = null;
      var fallbackStarted = false, activeScript = null;
      var isDeviceTest = {{ if .DeviceTest }}true{{ else }}false{{ end }};
      function launchProgress(phase) { if (phase) launchPhase = phase; lastLaunchProgressAt = Date.now(); }
      function stopWatchdog() {
        if (watchdogTimer) { clearInterval(watchdogTimer); watchdogTimer = null; }
        if (loadingHint) loadingHint.textContent = '';
      }
      function phaseText() {
        return { loader: 'loading the game loader (' + unitId + '.loader.js)', starting: 'starting Unity (no progress report yet)',
          assets: 'loading assets', compiling: 'compiling', almost: 'almost ready' }[launchPhase] || launchPhase;
      }
      // Can the loader file be fetched at all right now? Separates "the
      // service worker or network never answers" from "the page's own
      // script request is stuck".
      function probeLoader() {
        var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
        var timer = setTimeout(function() { if (ctrl) ctrl.abort(); }, 8000);
        var started = Date.now();
        var init = { cache: 'no-store', credentials: 'same-origin' };
        if (ctrl) init.signal = ctrl.signal;
        return fetch(loaderUrl, init).then(function(r) {
          clearTimeout(timer);
          return 'a fresh request for the loader file answered HTTP ' + r.status + ' in ' + (Date.now() - started) + ' ms';
        }, function(e) {
          clearTimeout(timer);
          return 'a fresh request for the loader file got no answer within 8 s (' + ((e && e.name) || 'error') + ')';
        });
      }
      function resetAdvice() {
        return isDeviceTest
          ? 'Go back to the test page, press Send report so we can see where it stopped, then press Reset this device and try again.'
          : 'Go back, open Manage, choose Reset all local Mission HydroSci data, and download the unit again.';
      }
      // Bypass the service worker: load the loader, engine and data straight
      // from the content server. Only while the loader script never arrived;
      // once Unity is starting, a second instance on the same canvas is not
      // an option.
      function retryFromContentServer() {
        var cdnBase = '{{ .CDNBaseURL }}';
        if (!cdnBase || fallbackStarted || launchPhase !== 'loader') return false;
        fallbackStarted = true;
        contentUrl = cdnBase + '/' + unitId + '/v' + unitVersion;
        buildUrl = contentUrl + '/Build';
        loaderUrl = buildUrl + '/' + unitId + '.loader.js';
        stepLog.record('launch', 'running', 'Trying again straight from the content server, bypassing the service worker…');
        if (loadingHint) loadingHint.textContent = 'Trying another way to load the game…';
        watchdogWarned = false;
        launchProgress('loader');
        var s2 = document.createElement('script');
        s2.src = loaderUrl;
        s2.onload = script.onload;
        s2.onerror = script.onerror;
        activeScript = s2;
        document.body.appendChild(s2);
        return true;
      }
      watchdogTimer = setInterval(function() {
        var idle = Date.now() - lastLaunchProgressAt;
        if (!watchdogWarned && idle >= WATCHDOG_WARN_MS) {
          watchdogWarned = true;
          probeLoader().then(function(probe) {
            stepLog.record('launch', 'warn', 'No progress for ' + Math.round(idle / 1000) + ' s while ' + phaseText() + ' — ' + probe);
            if (loadingHint) loadingHint.textContent = 'This is taking longer than usual. The page will try another way if it does not move soon. ' + resetAdvice();
            showStepLogOnFailure();
            memberReport('launch-stalled');
          });
        } else if (!watchdogFailed && idle >= WATCHDOG_ESCALATE_MS) {
          if (retryFromContentServer()) return;
          watchdogFailed = true;
          stopWatchdog();
          loadingText.textContent = 'Not loading';
          if (loadingHint) loadingHint.textContent = 'The game is not loading on this device. ' + resetAdvice();
          loadingBar.style.background = '#ef4444';
          stepLog.record('launch', 'fail', 'Still no progress after ' + Math.round(idle / 1000) + ' s — stuck ' + phaseText() +
            (fallbackStarted ? ', even straight from the content server' : '') + '. The game files are not reaching the page on this device.');
          showStepLogOnFailure();
          memberReport('launch-failed');
          reportCrash('load_stalled', 'No launch progress after ' + Math.round(idle / 1000) + ' s: ' + phaseText(), '', crashPhase);
        }
      }, 5000);

      // Load the Unity loader script
      stepLog.record('launch', 'running', 'Loading the game loader (' + unitId + '.loader.js)…');
      var script = document.createElement('script');
      script.src = loaderUrl;
      activeScript = script;
      script.onload = function() {
        if (this !== activeScript) return; // the first request answered after the content-server retry took over
        launchProgress('starting');
        loadingText.textContent = 'Starting Unity...';
        crashPhase = 'compiling';
        stepLog.record('launch', 'ok', 'Game loader loaded' + loaderSource());
        stepLog.record('launch', 'running', 'Starting Unity…');
        {{ if .DeviceTest }}deviceTestLoaderMs = Date.now() - launchStartedAt;{{ end }}

        createUnityInstance(canvas, {
          dataUrl: buildUrl + '/{{ .DataFile }}',
          frameworkUrl: buildUrl + '/{{ .FrameworkFile }}',
          codeUrl: buildUrl + '/{{ .CodeFile }}',
          streamingAssetsUrl: contentUrl + '/StreamingAssets',
          companyName: 'Adroit',
          productName: 'Mission HydroSci',
          productVersion: '1.0',
          autoSyncPersistentDataPath: true,
        }, function(progress) {
          launchProgress(progress < 0.5 ? 'assets' : (progress < 0.9 ? 'compiling' : 'almost'));
          loadingBar.style.width = (progress * 100) + '%';
          var milestone = progress < 0.5 ? 0 : (progress < 0.9 ? 1 : 2);
          if (milestone !== lastMilestone) {
            lastMilestone = milestone;
            stepLog.record('launch', 'running', ['Loading assets…', 'Compiling…', 'Almost ready…'][milestone] +
              ' (' + Math.round(progress * 100) + '%)');
          }
          if (progress < 0.5) {
            loadingText.textContent = 'Loading assets...';
          } else if (progress < 0.9) {
            loadingText.textContent = 'Compiling...';
            crashPhase = 'compiling';
          } else {
            loadingText.textContent = 'Almost ready...';
          }
        }).then(function(instance) {
          stopWatchdog();
          crashPhase = 'running';
          window.__unityInstance = instance;
          canvas = instance.Module.canvas;
          loadingOverlay.classList.add('hidden');
          onResize();
          stepLog.record('launch', 'ok', 'Unity started in ' + ((Date.now() - launchStartedAt) / 1000).toFixed(1) + ' s');

          // Tell MHSBridge this is PWA mode — game will use mhsUnitComplete callback.
          // Pass identity JSON for new builds; old builds ignore the parameter.
          instance.SendMessage('MHSBridge', 'OnPWAReady', JSON.stringify({
            user_id: '{{ .UserIDHex }}',
            name: '{{ .UserName }}'
          }));
          stepLog.record('game', 'running', 'Game running — identity sent to the game');
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              stepLog.record('game', 'ok', 'Game is rendering');
              memberReport('launch-ok');
              {{ if .DeviceTest }}
              deviceTestSummary({
                launch: { loader_ms: deviceTestLoaderMs, unity_ms: Date.now() - launchStartedAt, first_frame_ms: Date.now() - launchStartedAt },
                gameplay_reached: true
              });
              startHeartbeat();
              {{ end }}
            });
          });
        }).catch(function(err) {
          stopWatchdog();
          loadingText.textContent = 'Error: ' + err.message;
          stepLog.record('launch', 'fail', 'Unity failed to start: ' + err.message);
          showStepLogOnFailure();
          memberReport('launch-failed');
          loadingBar.style.width = '100%';
          loadingBar.style.background = '#ef4444';
          console.error('Unity load error:', err);
          reportCrash('load_error', err.message, err.stack || '', crashPhase);
        });
      };
      script.onerror = function() {
        if (this !== activeScript) return;
        stopWatchdog();
        loadingText.textContent = 'Failed to load game. Is this unit downloaded?';
        stepLog.record('launch', 'fail', 'The game loader failed to load — the unit may not be downloaded, or the content server is unreachable');
        showStepLogOnFailure();
        memberReport('launch-failed');
        loadingBar.style.width = '100%';
        reportCrash('load_error', 'Failed to load Unity loader script: ' + loaderUrl, '', 'loading');
        loadingBar.style.background = '#ef4444';
      };
      document.body.appendChild(script);
    })();

    // Focus the Unity canvas so it receives keyboard input.
    // Uses a delay to run after the CSS layout reflow that occurs
    // during fullscreen transitions (position: absolute → static).
    function focusCanvas() {
      var cvs = document.getElementById('unity-canvas');
      if (cvs) cvs.focus();
    }

    function toggleFullscreen() {
      var btn = document.getElementById('fullscreen-btn');
      var fs = document.fullscreenElement || document.webkitFullscreenElement;
      if (!fs) {
        // Fullscreen the container (not <html>) so keyboard events
        // route to the container subtree and reach the Unity canvas.
        var el = document.getElementById('unity-container');
        var p = el.requestFullscreen ? el.requestFullscreen() :
                el.webkitRequestFullscreen ? el.webkitRequestFullscreen() :
                Promise.reject();
        p.then(function() {
          btn.style.display = 'none';
          // Keyboard Lock API: ensure all key events (including letter keys)
          // are delivered to the page and not intercepted by the browser.
          // Required for Unity WebGL games in fullscreen where WASD input
          // would otherwise be consumed by browser/OS input handling.
          if (navigator.keyboard && navigator.keyboard.lock) {
            navigator.keyboard.lock().catch(function() {});
          }
          setTimeout(focusCanvas, 100);
        }).catch(function() {});
      } else {
        var p = document.exitFullscreen ? document.exitFullscreen() :
                document.webkitExitFullscreen ? document.webkitExitFullscreen() :
                Promise.reject();
        p.then(function() {
          btn.textContent = '\u26F6';
          btn.title = 'Fullscreen';
          btn.style.display = '';
          if (navigator.keyboard && navigator.keyboard.unlock) {
            navigator.keyboard.unlock();
          }
          // Restore JS-based sizing after exiting fullscreen
          if (window.__mhsResize) window.__mhsResize();
          setTimeout(focusCanvas, 100);
        }).catch(function() {});
      }
    }

    function onFullscreenChange() {
      var btn = document.getElementById('fullscreen-btn');
      var fs = document.fullscreenElement || document.webkitFullscreenElement;
      if (fs) {
        btn.style.display = 'none';
      } else {
        btn.textContent = '\u26F6';
        btn.title = 'Fullscreen';
        btn.style.display = '';
        if (window.__mhsResize) window.__mhsResize();
      }
      // Refocus canvas after layout settles
      setTimeout(focusCanvas, 150);
    }

    document.addEventListener('fullscreenchange', onFullscreenChange);
    document.addEventListener('webkitfullscreenchange', onFullscreenChange);

    // Register the service worker from the play page so it gets updated
    // even when the PWA opens directly to a play URL.
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js', {
        scope: '/'
      }).catch(function() {});
    }

    // Audio lifecycle management for Unity WebGL on iOS.
    //
    // iOS doesn't automatically suspend/resume AudioContexts when the app
    // is backgrounded (app switcher, switching apps). This causes two problems:
    // 1. Audio keeps playing when the game isn't visible
    // 2. When returning, iOS has suspended the AudioContext at the OS level
    //    but Unity doesn't know — the game renders but audio is dead
    //
    // On page leave (back button, bfcache), we fully shut down Unity and
    // close all AudioContexts to prevent zombie audio.

    // Suspend all AudioContexts (pauses audio, resumable)
    function suspendAllAudio() {
      var contexts = window.__mhsAudioContexts || [];
      for (var i = 0; i < contexts.length; i++) {
        try { if (contexts[i].state === 'running') contexts[i].suspend(); } catch (e) {}
      }
      var media = document.querySelectorAll('audio, video');
      for (var j = 0; j < media.length; j++) {
        try { media[j].pause(); } catch (e) {}
      }
    }

    // Resume all AudioContexts (restores audio after suspend)
    function resumeAllAudio() {
      var contexts = window.__mhsAudioContexts || [];
      for (var i = 0; i < contexts.length; i++) {
        try { if (contexts[i].state === 'suspended') contexts[i].resume(); } catch (e) {}
      }
    }

    // Full shutdown: quit Unity and permanently close all AudioContexts.
    // Order matters: detach Unity's onstatechange handlers BEFORE Quit(),
    // because Quit() tears down WEBAudio internals. If we close() contexts
    // after Quit(), the state change fires into a half-dead Unity module
    // causing "WEBAudio.audioInstances.forEach is not a function".
    function cleanupUnity() {
      var contexts = window.__mhsAudioContexts || [];
      // Detach Unity's audio state-change callbacks before teardown
      for (var i = 0; i < contexts.length; i++) {
        try { contexts[i].onstatechange = null; } catch (e) {}
      }
      if (window.__unityInstance) {
        try { window.__unityInstance.Quit(); } catch (e) {}
        window.__unityInstance = null;
      }
      for (var i = 0; i < contexts.length; i++) {
        try { contexts[i].close(); } catch (e) {}
      }
      var media = document.querySelectorAll('audio, video');
      for (var j = 0; j < media.length; j++) {
        try { media[j].pause(); media[j].src = ''; } catch (e) {}
      }
    }

    // Suspend/resume audio when the page visibility changes (app switcher,
    // switching to another app, locking the screen)
    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'hidden') {
        suspendAllAudio();
      } else {
        resumeAllAudio();
      }
    });

    // Full cleanup when the page is being navigated away or bfcached
    window.addEventListener('pagehide', cleanupUnity);

    // Clean up when the back button is clicked (before navigation starts).
    // The back button is only visible in PWA standalone mode (via CSS media query).
    var backBtn = document.getElementById('back-btn');
    if (backBtn) {
      backBtn.addEventListener('click', function(e) {
        e.preventDefault();
        cleanupUnity();
        window.location.href = backBtn.href;
      });
    }

    // Hide the fullscreen button when it's unnecessary or harmful:
    // 1. Standalone (PWA) mode — no browser chrome to hide, fullscreen is redundant.
    //    On ChromeOS, JS fullscreen + keyboard.lock() also disables top-row keys
    //    (volume, brightness, etc.), so hiding the button avoids that issue.
    // 2. iPad Safari — fullscreen suppresses all letter key DOM events (WASD etc.),
    //    a browser limitation with no JS workaround.
    // Detection: standalone mode via display-mode media query or navigator.standalone;
    // iPad via touch capability + Mac/iPad user agent (iPadOS reports as Macintosh).
    (function() {
      function hideFullscreenBtn() {
        var btn = document.getElementById('fullscreen-btn');
        if (btn) btn.style.display = 'none';
      }

      var isIPad = navigator.maxTouchPoints > 0 &&
        (/iPad/.test(navigator.userAgent) || /Macintosh/.test(navigator.userAgent));
      if (isIPad) {
        hideFullscreenBtn();
        return;
      }

      var mq = window.matchMedia('(display-mode: standalone)');
      if (mq.matches || navigator.standalone === true) {
        hideFullscreenBtn();
      }
      // Listen for display-mode changes — handles "Open App" in Chrome's URL bar,
      // which transitions from browser to standalone after page load.
      mq.addEventListener('change', function(e) {
        if (e.matches) hideFullscreenBtn();
      });
    })();

    // Help overlay: toggle with ? key (Shift+/)
    (function() {
      var overlay = document.getElementById('help-overlay');
      var visible = false;

      document.addEventListener('keydown', function(e) {
        if (e.key === '?') {
          visible = !visible;
          overlay.style.display = visible ? 'block' : 'none';
          e.preventDefault();
          e.stopPropagation();
        }
      });

      // Also dismiss by clicking the overlay
      overlay.addEventListener('click', function() {
        visible = false;
        overlay.style.display = 'none';
      });

      // Show a brief hint after game loads
      var hintShown = false;
      var observer = new MutationObserver(function() {
        var loadingOverlay = document.getElementById('loading-overlay');
        if (loadingOverlay && loadingOverlay.classList.contains('hidden') && !hintShown) {
          hintShown = true;
          observer.disconnect();
          // The help overlay opens only via the '?' key. On a touch-only device
          // (no fine pointer, so almost certainly no keyboard) that key is
          // unreachable, and "Press ? for help" would be a lie — skip it there.
          var hasFinePointer = window.matchMedia && window.matchMedia('(any-pointer: fine)').matches;
          if (!hasFinePointer) return;
          var hint = document.createElement('div');
          hint.id = 'help-hint';
          hint.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:80;background:rgba(0,0,0,0.7);color:white;padding:8px 20px;border-radius:20px;font-family:sans-serif;font-size:0.85rem;opacity:1;transition:opacity 1s;pointer-events:none;';
          hint.textContent = 'Press ? for help';
          document.getElementById('unity-container').appendChild(hint);
          setTimeout(function() { hint.style.opacity = '0'; }, 4000);
          setTimeout(function() { hint.remove(); }, 5000);
        }
      });
      var loadingEl = document.getElementById('loading-overlay');
      if (loadingEl) {
        observer.observe(loadingEl, { attributes: true, attributeFilter: ['class'] });
      }
    })();
    </script>

    <!--
      =========================================================================
      DISABLED: iPad two-finger look shim
      =========================================================================
      Commented out 2026-04-27. The Unity build now has native scroll wheel
      support via the input system. This shim would cause double input if
      both are active. Uncomment this block to restore the shim for older
      builds that don't have native scroll wheel support.
      =========================================================================

      =========================================================================
      EXPERIMENTAL: iPad two-finger look shim (ORIGINAL COMMENT BELOW)
      =========================================================================
      Prototype only. Lets existing WebGL builds respond to two-finger
      trackpad drag on iPad without rebuilding the game. Intended for UX
      validation in classroom iPads before the in-Unity fix
      (stratahub/docs/iPad-support/implementation-guide.md) ships.

      Behavior:
        - No-op on everything except iPad (detected via UA + maxTouchPoints).
        - On iPad, listens for wheel events on the Unity canvas (two-finger
          trackpad drags), and dispatches synthetic pointermove/mousemove
          events carrying the deltas so Unity's input layer sees continuous
          "mouse" movement that isn't bounded by the screen edge.

      This relies on Unity's WebGL input layer consuming synthetic events
      dispatched via addEventListener. That is true today but is an
      undocumented contract — DELETE THIS BLOCK once the in-Unity fix lands.

      If look goes the wrong direction, flip INVERT_X / INVERT_Y below.
      If speed feels off, adjust MULTIPLIER_X / MULTIPLIER_Y.
      =========================================================================
    -->
    <!-- SHIM DISABLED — uncomment to restore
    <script>
    (function () {
      'use strict';

      var MULTIPLIER_X = 1.0;
      var MULTIPLIER_Y = 1.0;
      var INVERT_X = true;
      var INVERT_Y = true;

      var ua = navigator.userAgent || '';
      var platform = navigator.platform || '';
      var touchPoints = navigator.maxTouchPoints || 0;
      var isIPad = /iPad/.test(ua) || (platform === 'MacIntel' && touchPoints > 1);
      if (!isIPad) {
        console.log('[iPad look shim] Not iPad — shim inactive.');
        return;
      }

      function attach() {
        var canvas = document.getElementById('unity-canvas') || document.querySelector('canvas');
        if (!canvas) { setTimeout(attach, 100); return; }

        // Virtual cursor position; starts at canvas center and drifts freely.
        var rect = canvas.getBoundingClientRect();
        var vx = rect.left + rect.width  / 2;
        var vy = rect.top  + rect.height / 2;

        canvas.addEventListener('wheel', function (e) {
          var dx = (INVERT_X ? -e.deltaX : e.deltaX) * MULTIPLIER_X;
          var dy = (INVERT_Y ? -e.deltaY : e.deltaY) * MULTIPLIER_Y;

          vx += dx;
          vy += dy;

          // Dispatch both pointermove and mousemove so we hit whichever path
          // Unity's WebGL input layer is listening on.
          try {
            var pe = new PointerEvent('pointermove', {
              bubbles: true, cancelable: true, view: window,
              pointerId: 1, pointerType: 'mouse', isPrimary: true,
              clientX: vx, clientY: vy, screenX: vx, screenY: vy,
              movementX: dx, movementY: dy,
              button: -1, buttons: 0
            });
            canvas.dispatchEvent(pe);
          } catch (_) {}

          var me = new MouseEvent('mousemove', {
            bubbles: true, cancelable: true, view: window,
            clientX: vx, clientY: vy, screenX: vx, screenY: vy,
            movementX: dx, movementY: dy,
            button: 0, buttons: 0
          });
          try {
            if (me.movementX !== dx) Object.defineProperty(me, 'movementX', { value: dx });
            if (me.movementY !== dy) Object.defineProperty(me, 'movementY', { value: dy });
          } catch (_) {}
          canvas.dispatchEvent(me);

          // Prevent the page from scrolling under the canvas.
          if (e.cancelable) e.preventDefault();
        }, { passive: false });

        console.log('[iPad look shim] Attached to canvas — two-finger drag should now look.');
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attach);
      } else {
        attach();
      }
    })();
    </script>
    END SHIM DISABLED -->
  </body>
</html>
{{ end }}
